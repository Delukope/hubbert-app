# Public site URL (canonical)
NEXT_PUBLIC_SITE_URL=https://hubberty.se

# Optional: Google PageSpeed Insights API
PAGESPEED_API_KEY=

# Optional: OpenAI for Swedish executive summaries
OPENAI_API_KEY=
