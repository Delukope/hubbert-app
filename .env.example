# Public site URL (canonical)
NEXT_PUBLIC_SITE_URL=https://hubberty.se

# Optional: Google PageSpeed Insights API (used after paid snabb/djup)
PAGESPEED_API_KEY=

# Optional: OpenAI — only after paid djup/tung
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Analysis prices in SEK
PRICE_SNABB_SEK=199
PRICE_DJUP_SEK=990
PRICE_TUNG_SEK=2490

# Stripe Checkout (leave empty until live)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SNABB=
STRIPE_PRICE_DJUP=
STRIPE_PRICE_TUNG=

# HMAC for magic pay links (fallback: Stripe secret)
HUBBERT_SIGNING_SECRET=

# Comma-separated IPs to refuse
ABUSE_IP_BLOCKLIST=

# Dev-only: unlock paid report UI without charging. Never enable in production.
ALLOW_DEMO_UNLOCK=false
